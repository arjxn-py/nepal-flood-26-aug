    "0b6c1a10-0000-4000-8001-000000000006": {
      "name": "Where the collapse happened",
      "parameters": {
        "content": {
          "attachments": {},
          "contentMode": "map",
          "image": "",
          "imageCaption": "",
          "markdown": "**The highest ground within 12 km of the red dot is\n6,828 m. The riverbed starts at\n2,382 m.**\n\nA drop of 4,446 m,\nmeasured from the terrain that shades this map. Ice falling that far turns to\nwater on impact. No lake had to burst for this to become a flood.\n\n**On the map:** \ud83d\udd34 the source \u00b7 the shading is the shape of the ground\n",
          "paneAlignment": "start",
          "panelWidth": "34%",
          "title": "Where the collapse happened"
