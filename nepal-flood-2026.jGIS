    "0b6c1a10-0000-4000-8001-000000000004": {
      "name": "The seismometer that recorded it",
      "parameters": {
        "content": {
          "attachments": {},
          "contentMode": "map",
          "image": "",
          "imageCaption": "",
          "markdown": "**Everything in the next segment comes from this one instrument.**\n\n**NK.KKN** at Kakani, **57 km** from the source,\nmeasures how fast the ground moves under it 50\ntimes a second and publishes the result openly.\n\n**On the map:** \u26ab the seismometer \u00b7 \ud83d\udd34 the source \u00b7 the grey line between them is the straight-line distance\n",
          "paneAlignment": "start",
          "panelWidth": "34%",
          "title": "The seismometer that recorded it"
        },
