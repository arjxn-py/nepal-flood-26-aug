    "0b6c1a10-0000-4000-8001-000000000019": {
      "name": "It ends in the Ganga, near Patna",
      "parameters": {
        "content": {
          "attachments": {},
          "contentMode": "map",
          "image": "",
          "imageCaption": "",
          "markdown": "**The Narayani crosses into India as the Gandak, runs south across Bihar, and\njoins the Ganga near Patna.**\n\nImpact becomes inundation on the way, and minutes of warning become hours.\nBelow the border it is India's flood, which is why the two countries share\nriver data.\n\n**On the map:** the dark blue line is this water, on into India as the Gandak \u00b7 \u26aa where it joins the Ganga, near Patna\n",
          "paneAlignment": "start",
          "panelWidth": "34%",
          "title": "It ends in the Ganga, near Patna"
        },
        "extent": [
          8817151.223777877,
          2618767.8416078635,
          10018106.61864212,
          3503514.236228596
