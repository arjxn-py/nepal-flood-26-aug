    "0b6c1a10-0000-4000-8001-000000000018": {
      "name": "The biggest rivers join at the end",
      "parameters": {
        "content": {
          "attachments": {},
          "contentMode": "map",
          "image": "",
          "imageCaption": "",
          "markdown": "**The Trishuli meets the Kali Gandaki at Devghat, km 189, and\nbecomes the Narayani.**\n\nNepal's largest rivers join at the end, the **Budhi Gandaki** at km 121, the **Marsyangdi** at km 155 and the Kali\nGandaki, so what leaves this valley is far more than its own water.\n\n**On the map:** the flood path \u00b7 the blue lines are the rivers joining it, the biggest of them near the end \u00b7 \u26aa Devghat\n",
          "paneAlignment": "start",
          "panelWidth": "34%",
          "title": "The biggest rivers join at the end"
        },
        "extent": [
          9303640.295392593,
          3127504.6265060506,
          9565013.39426574,
          3320058.744558874
        ],
