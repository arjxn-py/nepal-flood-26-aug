    "6a279ef1-3fa0-4737-b6f0-47f43766b2bc": {
      "filters": null,
      "name": "Sources",
      "parameters": {
        "bearing": null,
        "content": {
          "attachments": {},
          "contentMode": "markdown",
          "image": "",
          "imageCaption": "",
          "markdown": "**Sources**\n\n- Glacier outlines: GLIMS Consortium (2005), GLIMS Glacier Database, Version 1, NSIDC, doi:10.7265/N5V98602. Analyses 509052 (1967), 121892 and 121897 (1986), 121356 and 121361 (2003), and 1077809 and 1077804 (2022) by LGGE, now IGE, Grenoble; 707226 (2015) by the University of Zurich.\n- Satellite imagery: Esri, Maxar, Earthstar Geographics.\n- Terrain: AWS Terrain Tiles.\n",
          "paneAlignment": "center",
          "panelWidth": "25%"
        },
        "enableIdentify": false,
