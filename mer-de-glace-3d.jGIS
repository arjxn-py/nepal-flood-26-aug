    "dd752981-92cd-4805-aaa6-f03b39c4e770": {
      "filters": null,
      "name": "The whole glacier",
      "parameters": {
        "bearing": 0.0,
        "content": {
          "attachments": {},
          "contentMode": "map",
          "image": "",
          "imageCaption": "",
          "markdown": "**The outline covers the whole glacier, about 10.6 km from its northern to its southern end in 2022.**\n\nWe are now looking north, down the glacier. The ice comes from the basins in front and ends at the tongue in the distance, toward Chamonix.\n\nThe years are compared at the tongue, so the next steps zoom in there.\n",
          "paneAlignment": "start",
          "panelWidth": "30%"
        },
        "enableIdentify": false,
        "extent": [
          770330.876289453,
          5762739.131636348,
          770330.876289453,
