    "63ebcca2-85a6-49d9-8013-c58c50159bcd": {
      "filters": null,
      "name": "All five outlines",
      "parameters": {
        "bearing": 290.0,
        "content": {
          "attachments": {},
          "contentMode": "map",
          "image": "",
          "imageCaption": "",
          "markdown": "**All five outlines, from magenta (1967) to aqua (2022).**\n\nDistances are measured north to south, between the northernmost points of each outline. The outlines come from different teams and methods, so compare where the tongue ends, not the areas.\n",
          "paneAlignment": "start",
          "panelWidth": "30%"
        },
        "enableIdentify": false,
        "extent": [
          770776.1542526261,
