            "visible": false,
            "opacity": 1.0
          },
          {
            "targetLayer": "2c7f4b20-0000-4000-8000-00000000000a",
            "visible": false,
            "opacity": 1.0
          },
          {
            "targetLayer": "2c7f4b20-0000-4000-8000-00000000000b",
            "visible": true,
            "opacity": 1.0
          },
          {
            "targetLayer": "2c7f4b20-0000-4000-8000-00000000000c",
            "visible": false,
            "opacity": 1.0
          },
          {
            "targetLayer": "2c7f4b20-0000-4000-8000-00000000000d",
            "visible": false,
            "opacity": 1.0
          }
        ],
        "content": {
          "attachments": {},
          "contentMode": "map",
          "image": "",
          "imageCaption": "",
          "markdown": "**The bed here falls 42.5 m per km and the walls are close. The river was a\nthread through forest.**\n\nIt is now bare rock from wall to wall. In this 6 by 6 km box **703 features** are\nmarked destroyed. Timure Health Post, Timure Health Desk at Rasuwagadhi and\nSyafrubesi Health Post were all destroyed outright.\n\nAt this gradient water does not rise. It arrives.\n\n**On the map:** the red reach · dots are destroyed · bridges dark red where lost\n",
          "paneAlignment": "start",
          "panelWidth": "34%",
          "title": "The steep gorge"
        }
      }
    },
    "2c7f4b20-0000-4000-8001-000000000004": {
      "name": "The steep gorge, before and after",
      "type": "StorySegmentLayer",
      "visible": true,
      "parameters": {
        "zoom": 12.7,
        "extent": [
          9490009.329558322,
          3271854.1076403414,
          9516546.945296166,
          3291404.4256174252
        ],
        "transition": {
          "type": "linear",
          "time": 1.8
        },
        "layerOverride": [
          {
            "targetLayer": "2c7f4b20-0000-4000-8000-000000000002",
            "visible": true,
            "opacity": 0.25
          },
          {
            "targetLayer": "2c7f4b20-0000-4000-8000-000000000003",
