            "targetLayer": "2c7f4b20-0000-4000-8000-00000000000d",
            "visible": false,
            "opacity": 1.0
          }
        ],
        "content": {
          "attachments": {
            "fig-before-after-orange.png": {
              "image/png": ""
            }
          },
          "contentMode": "markdown",
          "image": "",
          "imageCaption": "",
          "markdown": "**Syabru Besi, the same six kilometres square, before the flood and after it.**\n\n![Syabru Besi, before and after](attachment:fig-before-after-orange.png)\n\nThe river was already broad here. It came out broader, pale with new sediment,\nand it took the fields and the road margin either side rather than the whole\nvalley floor.\n\nPale grey is ground no satellite saw clearly in the days after. Every pass was\n70 to 90 per cent cloud, so both sides are built from the clear pixels of\nseveral passes.\n",
          "paneAlignment": "start",
          "panelWidth": "34%",
          "title": "The middle valley, before and after"
        }
      }
    },
