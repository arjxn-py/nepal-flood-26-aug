    "2c7f4b20-0000-4000-8001-000000000007": {
      "name": "The middle valley, before and after",
      "parameters": {
        "content": {
          "attachments": {
            "fig-before-after-orange.png": {
              "image/png": ""
            }
          },
          "contentMode": "markdown",
          "image": "",
          "imageCaption": "",
          "markdown": "**Syabru Besi: the same six kilometre square, before the flood and after it.**\n\n![Syabru Besi, before and after](attachment:fig-before-after-orange.png)\n\nThe river was already wide here. It came out wider still, and pale with new sand.\nIt took the fields and the edge of the road. It did not take the whole valley\nfloor.\n",
          "paneAlignment": "start",
          "panelWidth": "52%",
          "title": "The middle valley, before and after"
        },
