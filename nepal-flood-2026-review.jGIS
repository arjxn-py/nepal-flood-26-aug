    "2c7f4b20-0000-4000-8001-000000000002": {
      "name": "The ground it came off, before and after",
      "parameters": {
        "content": {
          "attachments": {
            "fig-detachment-before-after.png": {
              "image/png": ""
            }
          },
          "contentMode": "markdown",
          "image": "",
          "imageCaption": "",
          "markdown": "**The same 4.5 km square, before the flood and after it.**\n\n![Where it came off, before and after](attachment:fig-detachment-before-after.png)\n\nBefore the flood, the brown outline held dark rock and a tongue of ice. In the\nsecond picture the ice is gone from the part the satellite could see. The ground\nunder it is grey and brown.\n\nThis is the highest and cloudiest box in the map. In the second picture, 38 per\ncent of the ground never got a clear look. In the first, only 1 per cent.\n\nThe teal outline on the left is one of the two lakes this story ends on.\n",
          "paneAlignment": "start",
          "panelWidth": "52%",
          "title": "The ground it came off, before and after"
        },
        "extent": [
          9514698.570043042,
          3281489.2321789563,
          9525476.191031367,
          3289429.1284921626
        ],
        "layerOverride": [
