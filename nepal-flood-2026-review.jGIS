            "targetLayer": "2c7f4b20-0000-4000-8000-000000000008",
            "visible": true,
            "opacity": 1.0
          },
          {
            "targetLayer": "2c7f4b20-0000-4000-8000-000000000009",
            "visible": false,
            "opacity": 1.0
          },
          {
            "targetLayer": "2c7f4b20-0000-4000-8000-00000000000a",
            "visible": false,
            "opacity": 1.0
          },
          {
            "targetLayer": "2c7f4b20-0000-4000-8000-00000000000b",
            "visible": false,
            "opacity": 1.0
          },
          {
            "targetLayer": "2c7f4b20-0000-4000-8000-00000000000c",
            "visible": false,
            "opacity": 1.0
          },
          {
            "targetLayer": "2c7f4b20-0000-4000-8000-00000000000d",
            "visible": false,
            "opacity": 1.0
          }
        ],
        "content": {
          "attachments": {},
          "contentMode": "map",
          "image": "",
          "imageCaption": "",
          "markdown": "**Ten minutes later, the river gauge at Syafrubesi stopped sending.**\n\nIts last reading was **1.62 m**. The station is twenty kilometres below the\nslope, and it did not report again.\n\nBy **09:15** the Department of Hydrology and Meteorology had confirmed a flood\nwave and put out warnings down the Trishuli corridor.\n**679,295 text messages** went to phones along the river.\n\nEveryone below the gauge got a warning. Everyone above it got the water.\n\n**On the map:** red dots are what was later marked destroyed\n",
          "paneAlignment": "start",
          "panelWidth": "34%",
          "title": "Ten minutes later the gauge went quiet"
        }
      }
    },
    "2c7f4b20-0000-4000-8001-000000000003": {
      "name": "The steep gorge",
      "type": "StorySegmentLayer",
      "visible": true,
      "parameters": {
        "zoom": 12.7,
        "extent": [
          9490009.329558322,
          3271854.1076403414,
          9516546.945296166,
          3291404.4256174252
        ],
        "transition": {
          "type": "linear",
          "time": 2.2
        },
        "layerOverride": [
          {
            "targetLayer": "2c7f4b20-0000-4000-8000-000000000002",
            "visible": true,
            "opacity": 0.25
          },
          {
            "targetLayer": "2c7f4b20-0000-4000-8000-000000000003",
