    "2c7f4b20-0000-4000-8001-000000000008": {
      "name": "The open valley",
      "parameters": {
        "content": {
          "attachments": {},
          "contentMode": "map",
          "image": "",
          "imageCaption": "",
          "markdown": "**Past Bidur the bed drops only 2.6 m per km. The river finally has room.**\n\nYou can still see the channel, but the valley is wide enough to hold it. The same\nbox holds **154** destroyed, against 342 and 715 upstream.\n\n**715, then 342, then 154**, in three boxes of the same size down one river.\n",
          "paneAlignment": "start",
          "panelWidth": "40%",
          "title": "The open valley"
        },
        "extent": [
          9460387.213057922,
