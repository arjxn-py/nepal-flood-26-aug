    "2c7f4b20-0000-4000-8001-000000000000": {
      "name": "08:40, and a mountain moved",
      "type": "StorySegmentLayer",
      "visible": true,
      "parameters": {
        "zoom": 12.0,
        "extent": [
          9498532.138560558,
          3269579.387709147,
          9541642.622513851,
          3301338.972961972
        ],
        "transition": {
          "type": "immediate",
          "time": 0.0
        },
        "layerOverride": [
          {
            "targetLayer": "2c7f4b20-0000-4000-8000-000000000002",
            "visible": true,
            "opacity": 0.25
          },
          {
            "targetLayer": "2c7f4b20-0000-4000-8000-000000000003",
            "visible": true,
            "opacity": 1.0
          },
          {
            "targetLayer": "2c7f4b20-0000-4000-8000-000000000004",
            "visible": false,
            "opacity": 1.0
          },
          {
            "targetLayer": "2c7f4b20-0000-4000-8000-000000000005",
            "visible": false,
            "opacity": 1.0
          },
          {
            "targetLayer": "2c7f4b20-0000-4000-8000-000000000006",
            "visible": false,
            "opacity": 1.0
          },
          {
            "targetLayer": "2c7f4b20-0000-4000-8000-000000000007",
            "visible": false,
            "opacity": 1.0
          },
          {
            "targetLayer": "2c7f4b20-0000-4000-8000-000000000008",
            "visible": false,
            "opacity": 1.0
          },
          {
            "targetLayer": "2c7f4b20-0000-4000-8000-000000000009",
            "visible": false,
            "opacity": 1.0
          },
          {
            "targetLayer": "2c7f4b20-0000-4000-8000-00000000000a",
            "visible": false,
            "opacity": 1.0
          },
          {
            "targetLayer": "2c7f4b20-0000-4000-8000-00000000000b",
            "visible": false,
            "opacity": 1.0
          },
          {
            "targetLayer": "2c7f4b20-0000-4000-8000-00000000000c",
            "visible": false,
            "opacity": 1.0
          },
          {
            "targetLayer": "2c7f4b20-0000-4000-8000-00000000000d",
            "visible": false,
            "opacity": 1.0
          }
        ],
        "content": {
          "attachments": {},
          "contentMode": "markdown",
          "image": "",
          "imageCaption": "",
          "markdown": "**At about twenty to nine on the morning of 26 August 2026, a square kilometre\nof a mountain let go.**\n\nIt came off a north-facing slope above the Lhende Khola, twenty kilometres above\nthe Nepal-China border: rock and ice, together with the loose ground a retreating\nglacier leaves behind it.\n\nSeismometers registered something over magnitude 5, and for a while the event was\ncarried as an earthquake. It was not an earthquake. It was the mountain reaching\nthe valley floor.\n\nWhat it became on the way down was not a landslide either. It took on water and\nsediment until it was moving as a flood, and that flood ran\n**210 km** down four rivers in a single day.\n\nThis map follows it, from the slope it came off to the plain where it stopped.\n\n*Scroll to begin.*\n",
          "paneAlignment": "start",
          "panelWidth": "34%",
          "title": "08:40, and a mountain moved"
        }
      }
    },
    "2c7f4b20-0000-4000-8001-000000000001": {
      "name": "The ground it came off",
      "type": "StorySegmentLayer",
      "visible": true,
      "parameters": {
        "zoom": 14.4,
        "extent": [
          9516003.425867312,
          3282450.5222409843,
          9524171.335207097,
          3288467.8384301346
        ],
        "transition": {
          "type": "linear",
          "time": 2.4
        },
        "layerOverride": [
          {
            "targetLayer": "2c7f4b20-0000-4000-8000-000000000002",
            "visible": true,
            "opacity": 0.25
          },
          {
            "targetLayer": "2c7f4b20-0000-4000-8000-000000000003",
            "visible": false,
            "opacity": 1.0
          },
          {
            "targetLayer": "2c7f4b20-0000-4000-8000-000000000004",
            "visible": false,
            "opacity": 1.0
          },
          {
