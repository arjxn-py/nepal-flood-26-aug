            "visible": false,
            "opacity": 1.0
          }
        ],
        "content": {
          "attachments": {},
          "contentMode": "map",
          "image": "",
          "imageCaption": "",
          "markdown": "**The new data has its own blind spots, and they are as shaped as the old ones.**\n\nThe damage record stops at **km 78**. The mapping projects change\nover at **km 78.9**. Below that line\nnothing is marked destroyed, though the extent runs to km 156.\n\n**On the map:** grey is ground that could not be assessed · outlines are the mapping projects\n",
          "paneAlignment": "start",
          "panelWidth": "34%",
          "title": "What is still missing"
        }
      }
    },
    "2c7f4b20-0000-4000-8001-000000000010": {
      "name": "Four counts of the same thing",
      "type": "StorySegmentLayer",
      "visible": true,
      "parameters": {
        "zoom": 8.6,
        "extent": [
          9256882.117232194,
          3081345.6937492713,
          9711959.114141138,
          3416601.8856210187
        ],
        "transition": {
          "type": "linear",
          "time": 2.0
        },
        "layerOverride": [
          {
            "targetLayer": "2c7f4b20-0000-4000-8000-000000000002",
            "visible": true,
            "opacity": 0.4
          },
          {
            "targetLayer": "2c7f4b20-0000-4000-8000-000000000003",
            "visible": true,
            "opacity": 1.0
          },
          {
            "targetLayer": "2c7f4b20-0000-4000-8000-000000000004",
            "visible": false,
            "opacity": 1.0
          },
          {
