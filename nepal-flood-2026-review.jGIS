    "2c7f4b20-0000-4000-8001-000000000000": {
      "name": "What I mapped before I had the data",
      "type": "StorySegmentLayer",
      "visible": true,
      "parameters": {
        "zoom": 8.6,
        "extent": [
          9256882.117232194,
          3081345.6937492713,
          9711959.114141138,
          3416601.8856210187
        ],
        "transition": {
          "type": "immediate",
          "time": 0.0
        },
        "layerOverride": [
          {
            "targetLayer": "2c7f4b20-0000-4000-8000-000000000002",
            "visible": true,
            "opacity": 0.4
          },
          {
            "targetLayer": "2c7f4b20-0000-4000-8000-000000000003",
            "visible": true,
            "opacity": 1.0
          },
          {
            "targetLayer": "2c7f4b20-0000-4000-8000-000000000004",
            "visible": false,
            "opacity": 1.0
